{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Converter",
    "shortDescription": "Convierte archivos con una paleta radial",
    "resources": {
      "../../vendor/bin/pdfium/pdfium.dll": "pdfium/pdfium.dll",
      "../../vendor/bin/pdfium/LICENSE-pdfium": "pdfium/LICENSE-pdfium"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "installerHooks": "nsis-hooks.nsh",
        "template": "nsis/installer.nsi",
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libreoffice-writer"
        ]
      },
      "rpm": {
        "depends": [
          "libreoffice-writer"
        ]
      }
    }
  }
}
